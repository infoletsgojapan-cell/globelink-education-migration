# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://www.globelinkedu.com"

# SUPABASE INTEGRATION (Optional for persistent inquiry storage):
# In frontend Vite environments, prefix client keys with VITE_
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# GOOGLE SEARCH CONSOLE & ANALYTICS (Optional):
VITE_GOOGLE_SITE_VERIFICATION="your-gsc-verification-code"
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
